---
title: {{ (conv.title or "Untitled") | tojson }}
platform: {{ conv.platform | tojson }}
model: {{ (conv.model_primary or "unknown") | tojson }}
date: {{ ((conv.started_at or "")[:10]) | tojson }}
conv_uid: {{ conv.uid | tojson }}
tags: {{ (["chatvault", conv.platform] + conv.tags) | tojson }}
---

# {{ conv.title or "Untitled" }}

{% for msg in conv.messages %}
{% if msg.role in ("user", "assistant") %}
## {{ msg.role | capitalize }}

{% for block in msg.blocks %}
{% if block.type in ("text", "code") %}
{{ block.text }}

{% elif block.type in ("tool_use", "tool_result") %}
> tool: {{ block.tool_name or "unknown" }} (collapsed)

{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

{% if conv.tags %}
## Tags

{% for t in conv.tags %}
- [[{{ t }}]]
{% endfor %}
{% endif %}
