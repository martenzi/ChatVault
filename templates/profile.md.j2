# {{ conv.title or "Untitled" }}

- platform: {{ conv.platform }}
- model: {{ conv.model_primary or "unknown" }}
- date: {{ (conv.started_at or "")[:10] }}
- uid: `{{ conv.uid }}`
- profile: {{ profile }}
{% if conv.tags %}
- tags: {{ conv.tags | join(", ") }}
{% endif %}

---

{% for msg in conv.messages %}
## {{ msg.role | capitalize }}

{% for block in msg.blocks %}
{% if block.type in ("text", "code") %}
{{ block.text }}

{% elif block.type == "thinking" %}
<details><summary>thinking</summary>

{{ block.text }}

</details>

{% elif block.type in ("tool_use", "tool_result") %}
> {{ block.text }}

{% elif block.type == "attachment" %}
*[attachment: {{ block.text[:80] }}]*

{% elif block.type == "image" %}
*[image block]*

{% elif block.type == "error" %}
**error:** {{ block.text }}

{% elif block.type == "refusal" %}
**refused:** {{ block.text }}

{% elif block.type == "audio" %}
*[audio block]*

{% elif block.type == "injected_context" %}
<details><summary>injected context</summary>

{{ block.text }}

</details>

{% elif block.type == "meta" %}
*[meta: {{ block.text[:80] }}]*

{% else %}
*[{{ block.type }} block]*

{% endif %}
{% endfor %}
{% endfor %}
