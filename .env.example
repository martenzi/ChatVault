# Root of the vault: raw exports, SQLite DBs, exports, attachments all live
# under here. Defaults to the current working directory if unset.
CHATVAULT_ROOT=/home/user/ChatVault

# Optional directory overrides (default to <CHATVAULT_ROOT>/db/backups,
# <CHATVAULT_ROOT>/archive, <CHATVAULT_ROOT>/attachments)
# CHATVAULT_BACKUP_DIR=
# CHATVAULT_ARCHIVE_DIR=
# CHATVAULT_ATTACHMENT_DIR=

# Optional: Neo4j graph projection (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
